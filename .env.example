# Копирую в .env и заполняю : cp .env.example .env
# .env в git не попадает, там настоящие пароли

DB_NAME=sup_shop
DB_USERNAME=sup_admin
DB_PASSWORD=change-me

# минимум 32 символа, сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me

# откуда открываю сайт; через Nginx запросы и так с того же адреса, но на проде переменная обязательна
CORS_ALLOWED_ORIGINS=http://localhost:3000

# первый админ создаётся при старте, если его ещё нет
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@supshop.md
ADMIN_PASSWORD=change-me

APP_PORT=3000